NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Site URL for email links, OG metadata, sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Auth & admin (ADMIN_EMAIL or comma-separated ADMIN_EMAILS)
ADMIN_EMAIL=your_admin_email_here
# ADMIN_EMAILS=ops@yourdomain.com,programs@yourdomain.com

# SOF four-digit access codes — required in production for new SOF approvals
SOF_PIN_SECRET=generate_a_long_random_secret_here

# Email (Resend — program mail + Supabase Auth SMTP password)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Weatherhaven Programs <noreply@yourdomain.com>
# Use the same RESEND_API_KEY as Supabase Auth → SMTP password (see docs/EMAIL_SETUP.md)
EMAIL_REPLY_TO=
NOTIFY_TO=leads@yourdomain.com

# Optional: hero video when /public/hero.mp4 is deployed
NEXT_PUBLIC_HERO_VIDEO_READY=false

# Optional: override homepage Google My Maps id (default is Weatherhaven global map)
NEXT_PUBLIC_GOOGLE_MY_MAPS_MID=

# Optional: rate limiting (Vercel Upstash integration)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: error monitoring
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Optional: webhooks and tokens
# REQUEST_ACCESS_WEBHOOK_URL=
# LEADS_ADMIN_TOKEN=
# LEADS_REGISTER_VIEW_TOKEN=
